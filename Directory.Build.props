<Project>
    <PropertyGroup>
        <!-- Версия плагина: единый источник для всех проектов и релизного скрипта (тег = v<PluginVersion>).
             Поднимать только здесь — версия уходит в nupkg, zip и mars-plugin.json. -->
        <PluginVersion>0.0.1</PluginVersion>
        <!-- Версия пакетов Марса (Mars.Plugin.Sdk, Mars.Plugin.Kit.*, Mars.Data.*): выравнивать с релизом
             Марса (MarsAppVersion в Directory.Build.props репозитория Mars). Плагин пакуется
             инструментом той версии платформы, для которой предназначен. -->
        <MarsVersion>0.8.4-alpha.57</MarsVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Version>$(PluginVersion)</Version>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Общая метадата NuGet-пакета. Проектно-специфичное (PackageId/Description/RepositoryUrl) —
         в основном csproj плагина. -->
    <PropertyGroup>
        <Authors>MyPluginCompany</Authors>
        <Company>MyPluginCompany</Company>
        <RepositoryType>Git</RepositoryType>
        <PackageTags>Mars</PackageTags>
        <PackageIcon>icon.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
    </ItemGroup>
</Project>
