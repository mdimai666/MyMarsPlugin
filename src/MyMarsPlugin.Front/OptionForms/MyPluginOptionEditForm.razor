@using System.ComponentModel.DataAnnotations
@using Mars.Admin.Framework.Components
@using Mars.Options.Abstractions.Attributes
@using Microsoft.FluentUI.AspNetCore.Components
@using MyMarsPlugin.Shared.Options
@attribute [OptionEditFormForOptionAttribute(typeof(MyPluginOption))]
@attribute [Display(Name = "My Plugin Option")]
@attribute [AutoShowFormOnSettingsPage]

<EditOptionForm @ref=form TModel="MyPluginOption">
    <h3>Настройки MyPluginOption</h3>
    <FormItem2 For=@(() => context.OptionValue)>
        <FluentTextInput @bind-Value=context.OptionValue Class="" />
    </FormItem2>
</EditOptionForm>

@code {
    EditOptionForm<MyPluginOption>? form;

}
