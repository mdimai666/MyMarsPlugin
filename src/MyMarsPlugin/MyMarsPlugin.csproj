<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <!--Public-->
        <PackageId>MyPluginCompany.MyMarsPlugin</PackageId>
        <Product>MyMarsPlugin</Product>
        <Title>MyMarsPlugin</Title>
        <Description>
            Plugin template
        </Description>
        <RepositoryUrl>https://github.com/mdimai666/MyMarsPlugin</RepositoryUrl>

        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup>
        <!--this is information for mars-->
        <AssemblyMetadata Include="PackageTags" Value="$(PackageTags)" />
        <AssemblyMetadata Include="PackageId" Value="$(PackageId)" />
        <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
        <AssemblyMetadata Include="PackageIcon" Value="$(PackageIcon)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Link="wwwroot\icon.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="mdimai666.Mars.Data.PostgreSQL" Version="$(MarsVersion)" />
        <PackageReference Include="mdimai666.Mars.Plugin.Sdk" Version="$(MarsVersion)" PrivateAssets="all" />
        <PackageReference Include="mdimai666.Mars.Plugin.Kit.Host" Version="$(MarsVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyMarsPlugin.Front\MyMarsPlugin.Front.csproj" />
        <ProjectReference Include="..\MyMarsPlugin.Shared\MyMarsPlugin.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.local.json">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Паковка — таргетами пакета mdimai666.Mars.Plugin.Sdk (без явных таргетов здесь):
         publish Release -> отсечение сборок Марса + манифест + дескриптор + zip;
         dotnet msbuild -t:MarsPluginPackNuget -c Release -> nupkg;
         Debug-сборка -> дев-манифест. -->

</Project>
