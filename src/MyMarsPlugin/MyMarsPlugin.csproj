<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!--Public-->
        <PackageId>MyPluginCompany.MyMarsPlugin</PackageId>
        <Version>0.0.1</Version>
        <PackageVersion>0.0.1</PackageVersion>
        <Authors>MyPluginCompany</Authors>
        <Company>MyPluginCompany</Company>
        <Product>MyMarsPlugin</Product>
        <PackageTags>Mars;</PackageTags>
        <Description>
            Plugin template
        </Description>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/mdimai666/MyMarsPlugin</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>

        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup>
        <!--this is information for mars-->
        <AssemblyMetadata Include="PackageTags" Value="$(PackageTags)" />
        <AssemblyMetadata Include="PackageId" Value="$(PackageId)" />
        <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
        <AssemblyMetadata Include="PackageIcon" Value="$(PackageIcon)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Link="wwwroot\icon.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="mdimai666.Mars.Data.PostgreSQL" Version="0.8.2-alpha.5" />
        <PackageReference Include="mdimai666.Mars.Plugin.Sdk" Version="0.8.2-alpha.5" PrivateAssets="all" />
        <PackageReference Include="mdimai666.Mars.Plugin.Kit.Host" Version="0.8.2-alpha.5" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyMarsPlugin.Front\MyMarsPlugin.Front.csproj" />
        <ProjectReference Include="..\MyMarsPlugin.Shared\MyMarsPlugin.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.local.json">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Паковка — таргетами пакета mdimai666.Mars.Plugin.Sdk (без явных таргетов здесь):
         publish Release -> отсечение сборок Марса + манифест + дескриптор + zip;
         dotnet msbuild -t:MarsPluginPackNuget -c Release -> nupkg;
         Debug-сборка -> дев-манифест. -->

</Project>
